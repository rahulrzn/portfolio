{
  "name": "rahul-reji-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/seo.mjs",
    "preview": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "admin:password": "node scripts/admin-password.mjs",
    "db:migrate:local": "wrangler d1 migrations apply PORTFOLIO_DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "deploy:check": "node scripts/check-deployment.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
